<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="14dp"
    app:strokeColor="@color/green_light"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/layoutCrudButtons"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCrudProdName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sofa Ruang Tamu"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCrudProdMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Sofa • Stok: 12 • Kayu Jati"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvCrudProdPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Rp 3.000.000"
                android:textColor="@color/green_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutCrudButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditProd"
                android:layout_width="64dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="Edit"
                android:textAllCaps="false"
                android:textSize="11sp"
                app:backgroundTint="@color/accent_wood"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteProd"
                android:layout_width="68dp"
                android:layout_height="36dp"
                android:text="Hapus"
                android:textAllCaps="false"
                android:textSize="11sp"
                app:backgroundTint="#B03A2E"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>